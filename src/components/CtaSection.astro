<section class="cta-section" id="contact">
  <div class="container">
    <div class="cta-grid">
      <div class="cta-text reveal">
        <h2>Tailor Your Own Silk Road Tour Within 24 Hours</h2>
        <p>Tell us your dream journey and we'll craft a personalized itinerary — no obligation, just inspiration.</p>
        <div class="cta-features">
          <div class="cta-feature">&check; 24/7 Customer Service</div>
          <div class="cta-feature">&check; No Shopping Stops</div>
          <div class="cta-feature">&check; No Hidden Charges</div>
          <div class="cta-feature">&check; 99% Excellent Service</div>
          <div class="cta-feature">&check; English-Speaking Guides</div>
          <div class="cta-feature">&check; Flexible Cancellation</div>
        </div>
        <div style="margin-top:24px;padding:16px;background:rgba(255,255,255,0.1);border-radius:8px;">
          <p style="color:white;margin:0 0 8px 0;font-size:0.9rem;">⭐ <strong>4.9/5</strong> from 320+ verified reviews</p>
          <p style="color:rgba(255,255,255,0.8);margin:0;font-size:0.85rem;">Join 20,000+ happy travelers who have explored the Silk Road with us</p>
        </div>
      </div>
      <div class="cta-form reveal">
        <h3>Get Your Free Custom Quote</h3>
        <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:16px;">Reply within <strong>24 hours</strong> · No obligation · 100% free</p>
        <form id="inquiryFormCta">
          <div class="form-row">
            <div class="form-group"><label for="ctaName">Full Name *</label><input type="text" id="ctaName" name="name" placeholder="Your full name" required></div>
            <div class="form-group"><label for="ctaEmail">Email *</label><input type="email" id="ctaEmail" name="email" placeholder="your@email.com" required></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label for="ctaPhone">Phone / WhatsApp</label><input type="tel" id="ctaPhone" name="phone" placeholder="+1 555 123 4567"></div>
            <div class="form-group"><label for="ctaNationality">Nationality</label><input type="text" id="ctaNationality" name="nationality" placeholder="e.g. American, German"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label for="ctaDate">Planned Travel Date</label><input type="date" id="ctaDate" name="date"></div>
            <div class="form-group"><label for="ctaTravelers">Number of Travelers</label><select id="ctaTravelers" name="travelers"><option>Select...</option><option>1 person</option><option>2 people</option><option>3-5 people</option><option>6-10 people</option><option>10+ people</option></select></div>
          </div>
          <div class="form-group"><label for="ctaMessage">Tell Us About Your Trip</label><textarea id="ctaMessage" name="message" placeholder="Which destinations interest you? What's your budget? Any special requests?"></textarea></div>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;font-size:0.75rem;color:var(--text-muted);">
            <input type="checkbox" id="ctaPrivacyCta" name="privacy" required style="margin:0;">
            <label for="ctaPrivacyCta" style="margin:0;font-weight:normal;">I agree to the <a href="/privacy-policy.html" style="color:var(--navy);text-decoration:underline;">Privacy Policy</a></label>
          </div>
          <button type="submit" class="btn btn-primary form-submit" style="width:100%;">✈️ Get My Free Quote</button>
        </form>
        <div style="text-align:center;margin-top:14px;font-size:0.78rem;color:var(--text-muted);">
          <p style="margin:0;">💬 Prefer to chat? <a href="https://wa.me/8615347723823" style="color:var(--navy);text-decoration:underline;">WhatsApp</a> · <a href="tel:+8615347723823" style="color:var(--navy);text-decoration:underline;">Call</a></p>
        </div>
      </div>
    </div>
  </div>
</section>
