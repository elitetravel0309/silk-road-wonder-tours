<!-- Floating Contact Buttons -->
<div class="floating-contact" id="floatingContact">
  <!-- Main toggle button -->
  <button class="fc-toggle" id="fcToggle" aria-label="Contact us">
    <span class="fc-icon-chat">💬</span>
    <span class="fc-icon-close">✕</span>
  </button>

  <!-- Expanded options -->
  <div class="fc-options" id="fcOptions">
    <button class="fc-option fc-wechat" id="fcWechat" aria-label="Contact via WeChat">
      <span class="fc-option-icon">💚</span>
      <span class="fc-option-label">WeChat</span>
    </button>
    <button class="fc-option fc-whatsapp" id="fcWhatsapp" aria-label="Contact via WhatsApp">
      <span class="fc-option-icon">💬</span>
      <span class="fc-option-label">WhatsApp</span>
    </button>
  </div>
</div>

<!-- WeChat QR Modal -->
<div class="fc-modal" id="wechatModal">
  <div class="fc-modal-overlay" data-close="wechatModal"></div>
  <div class="fc-modal-content">
    <button class="fc-modal-close" data-close="wechatModal" aria-label="Close">✕</button>
