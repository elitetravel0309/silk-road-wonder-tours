---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/CtaSection.astro';
---
<BaseLayout title="Top China Tours — Best China Travel Packages" description="Best China tour packages combining the Silk Road with Beijing, Xi’an, Shanghai, Guilin, Zhangjiajie. Private China tours from 8 to 16 days." ogImage="/assets/images/hero-mountains.jpg">
<section class="page-hero" style="background: linear-gradient(rgba(0,0,0,0.45),rgba(0,0,0,0.45)),url('/assets/images/hero-silkroad.jpg') center/cover;">
  <div class="container"><h1>Top China</h1><p>China’s finest journeys — curated tours combining Silk Road treasures with China’s greatest highlights</p></div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://silkroadwondertours.com/" },
    { "@type": "ListItem", "position": 2, "name": "Top China Tours" }
  ]
}
</script>
<nav class="breadcrumb" aria-label="Breadcrumb"><div class="container"><a href="/">Home</a> <span class="sep">/</span> <span>Top China Tours</span></div></nav>

<section class="section"><div class="container">
<div class="section-header reveal">
  <h2>The Best of China, Expertly Crafted</h2>
  <div class="divider"></div>
  <p>China is vast, ancient, and endlessly fascinating — a single country that spans climates from subtropical to alpine, and cultures from imperial dynasties to 21st-century megacities. Our Top China Tours are carefully designed to showcase the very best of this extraordinary nation.</p>
  <p style="margin-top:12px;">All tours are fully private and customizable. Our expert English-speaking guides bring China’s 5,000-year history to life. The best seasons are spring (April to May) and autumn (September to November).</p>
</div></div></section>

<section class="section section-alt"><div class="container">
<div class="tours-grid">

  <div class="tour-card reveal">
    <div class="tour-card-img"><img src="/assets/images/hero-silkroad.jpg" alt="China Golden Triangle" loading="lazy" width="1200" height="800"></div>
    <div class="tour-card-body">
      <div class="tour-card-meta"><span class="tour-duration">8 Days</span><span class="tour-price">$1,890</span></div>
      <h3>China Golden Triangle</h3>
      <p class="tour-route">Beijing → Xi’an → Shanghai</p>
      <p class="tour-desc">The classic China itinerary — walk the Great Wall, meet the Terracotta Warriors, and cruise the Huangpu River. Perfect for first-time visitors who want China’s three greatest cities.</p>
      <a href="/contact.html" class="btn btn-gold">View Details</a>
    </div>
  </div>
  <div class="tour-card reveal">
    <div class="tour-card-img"><img src="/assets/images/hero-silkroad.jpg" alt="China Highlights" loading="lazy" width="1200" height="800"></div>
    <div class="tour-card-body">
      <div class="tour-card-meta"><span class="tour-duration">12 Days</span><span class="tour-price">$2,680</span></div>
      <h3>China Highlights</h3>
      <p class="tour-route">Beijing → Xi’an → Guilin → Shanghai</p>
      <p class="tour-desc">Add the ethereal karst landscapes of Guilin to the Golden Triangle. Cruise the Li River, cycle through Yangshuo’s rice paddies, and explore the Reed Flute Caves.</p>
      <a href="/contact.html" class="btn btn-gold">View Details</a>
    </div>
  </div>
  <div class="tour-card reveal">
    <div class="tour-card-img"><img src="/assets/images/hero-silkroad.jpg" alt="Silk Road & Tibet" loading="lazy" width="1200" height="800"></div>
    <div class="tour-card-body">
      <div class="tour-card-meta"><span class="tour-duration">15 Days</span><span class="tour-price">$3,490</span></div>
      <h3>Silk Road & Tibet</h3>
      <p class="tour-route">Beijing → Xi’an → Lhasa → Dunhuang → Shanghai</p>
      <p class="tour-desc">Combine China’s imperial capitals with Tibet and the Silk Road. Visit the Potala Palace, Mogao Caves, and Great Wall in one epic cross-country journey.</p>
      <a href="/contact.html" class="btn btn-gold">View Details</a>
    </div>
  </div>
  <div class="tour-card reveal">
    <div class="tour-card-img"><img src="/assets/images/desert-dunes.jpg" alt="China Panorama" loading="lazy" width="1200" height="800"></div>
    <div class="tour-card-body">
      <div class="tour-card-meta"><span class="tour-duration">14 Days</span><span class="tour-price">$3,120</span></div>
      <h3>China Panorama</h3>
      <p class="tour-route">Beijing → Zhangjiajie → Chengdu → Shanghai</p>
      <p class="tour-desc">From the Great Wall to Avatar Mountains, pandas to neon skylines. China’s greatest hits across 14 unforgettable days with Panda encounters and fiery Sichuan cuisine.</p>
      <a href="/contact.html" class="btn btn-gold">View Details</a>
    </div>
  </div>
  <div class="tour-card reveal">
    <div class="tour-card-img"><img src="/assets/images/hero-silkroad.jpg" alt="Classic China Family Tour" loading="lazy" width="1200" height="800"></div>
    <div class="tour-card-body">
      <div class="tour-card-meta"><span class="tour-duration">10 Days</span><span class="tour-price">$2,350</span></div>
      <h3>Classic China Family Tour</h3>
      <p class="tour-route">Beijing → Xi’an → Chengdu → Shanghai</p>
      <p class="tour-desc">A family-friendly adventure — kite flying on the Great Wall, warrior-making workshops in Xi’an, panda volunteering in Chengdu, and the Shanghai Science Museum.</p>
      <a href="/contact.html" class="btn btn-gold">View Details</a>
    </div>
  </div>
  <div class="tour-card reveal">
    <div class="tour-card-img"><img src="/assets/images/hero-silkroad.jpg" alt="China Nature & Culture" loading="lazy" width="1200" height="800"></div>
    <div class="tour-card-body">
      <div class="tour-card-meta"><span class="tour-duration">16 Days</span><span class="tour-price">$3,850</span></div>
      <h3>China Nature & Culture</h3>
      <p class="tour-route">Beijing → Zhangjiajie → Guilin → Kunming → Lijiang</p>
      <p class="tour-desc">China's most spectacular natural wonders — Zhangjiajie's pillars, Guilin's karst, the Stone Forest, and Jade Dragon Snow Mountain. A photographer's dream.</p>
      <a href="/contact.html" class="btn btn-gold">View Details</a>
    </div>
  </div>
  <div class="tour-card reveal">
    <div class="tour-card-img"><img src="/assets/images/hero-silkroad.jpg" alt="Imperial China & Yangtze" loading="lazy" width="1200" height="800"></div>
    <div class="tour-card-body">
      <div class="tour-card-meta"><span class="tour-duration">13 Days</span><span class="tour-price">$3,050</span></div>
      <h3>Imperial China & Yangtze</h3>
      <p class="tour-route">Beijing → Xi’an → Chongqing → Yangtze Cruise → Shanghai</p>
      <p class="tour-desc">Combine the imperial capitals with a 4-night luxury Yangtze River cruise through the Three Gorges. Ancient civilization meets breathtaking natural scenery.</p>
      <a href="/contact.html" class="btn btn-gold">View Details</a>
    </div>
  </div>
</div>
</div></section>

<section class="cta-section"><div class="container"><div class="cta-grid">
  <div class="cta-text reveal"><h2>Design Your Dream China Tour</h2><p>Let our expert team craft your perfect itinerary — free consultation, no obligation.</p><a href="/contact.html" class="btn btn-gold">Contact Us Today</a></div>
</div></div></section>
<CtaSection />
</BaseLayout>