      <div class="stat-row"><span class="label">Duration</span><span class="value">7 Days / 6 Nights</span></div>
      <div class="stat-row"><span class="label">Group Size</span><span class="value">Max 16 people</span></div>
      <div class="stat-row"><span class="label">Hotel Level</span><span class="value">4-Star</span></div>
      <div class="stat-row"><span class="label">Departure</span><span class="value">Every Wednesday</span></div>
      <div class="stat-row"><span class="label">Start / End</span><span class="value">Dunhuang / Xining</span></div>
      <div class="stat-row"><span class="label">Best Season</span><span class="value">May — Oct</span></div>
