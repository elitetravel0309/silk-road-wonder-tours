---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/CtaSection.astro';
---
<BaseLayout title="Cancellation Policy" description="Our fair and transparent cancellation policy. Full refund minus fees for 30+ days, 70% for 15-29 days, 50% for 7-14 days before departure." ogImage="/assets/images/hero-mountains.jpg">
<section class="page-hero" style="background: url('/assets/images/xinjiang-landscape.jpg') center/cover;">
  <div class="container"><h1>Cancellation Policy</h1><p>Our fair and transparent cancellation terms</p></div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://silkroadwondertours.com/" },
    { "@type": "ListItem", "position": 2, "name": "Cancellation Policy" }
  ]
}
</script>
<nav class="breadcrumb" aria-label="Breadcrumb"><div class="container"><a href="/">Home</a> <span class="sep">/</span> <span>Cancellation Policy</span></div></nav>

<!-- CANCELLATION TIMELINE -->
<section class="section"><div class="container"><div class="section-header reveal"><h2>Cancellation & Refund Terms</h2><div class="divider"></div><p>We understand that plans can change. Here's our straightforward cancellation policy</p></div>

<div class="timeline-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-top:40px;">
  <div class="timeline-card reveal" style="background:#fff;border:1px solid #e8e8e8;border-radius:12px;padding:32px 24px;text-align:center;border-top:4px solid #4CAF50;">
    <div style="font-size:36px;margin-bottom:12px;">&#9989;</div>
    <h3 style="font-size:20px;color:#1a1a1a;margin-bottom:4px;">30+ Days Before Departure</h3>
    <div style="font-size:32px;color:#4CAF50;font-weight:700;margin:12px 0;">Full Refund</div>
    <p style="color:#666;font-size:14px;">100% refund minus any non-recoverable booking fees (such as flight and train ticket cancellation charges).</p>
  </div>
  <div class="timeline-card reveal" style="background:#fff;border:1px solid #e8e8e8;border-radius:12px;padding:32px 24px;text-align:center;border-top:4px solid #2196F3;">
    <div style="font-size:36px;margin-bottom:12px;">&#9888;</div>
    <h3 style="font-size:20px;color:#1a1a1a;margin-bottom:4px;">15-29 Days Before Departure</h3>
    <div style="font-size:32px;color:#2196F3;font-weight:700;margin:12px 0;">70% Refund</div>
    <p style="color:#666;font-size:14px;">70% of the total tour cost will be refunded. 30% is retained to cover preparation costs.</p>
  </div>
  <div class="timeline-card reveal" style="background:#fff;border:1px solid #e8e8e8;border-radius:12px;padding:32px 24px;text-align:center;border-top:4px solid #FF9800;">
    <div style="font-size:36px;margin-bottom:12px;">&#9888;</div>
    <h3 style="font-size:20px;color:#1a1a1a;margin-bottom:4px;">7-14 Days Before Departure</h3>
    <div style="font-size:32px;color:#FF9800;font-weight:700;margin:12px 0;">50% Refund</div>
    <p style="color:#666;font-size:14px;">50% of the total tour cost will be refunded. Many services have already been prepaid by this time.</p>
  </div>
  <div class="timeline-card reveal" style="background:#fff;border:1px solid #e8e8e8;border-radius:12px;padding:32px 24px;text-align:center;border-top:4px solid #F44336;">
    <div style="font-size:36px;margin-bottom:12px;">&#10060;</div>
    <h3 style="font-size:20px;color:#1a1a1a;margin-bottom:4px;">Less Than 7 Days</h3>
    <div style="font-size:32px;color:#F44336;font-weight:700;margin:12px 0;">No Refund</div>
    <p style="color:#666;font-size:14px;">Cancellations within 7 days of departure are non-refundable as all services have been confirmed and paid.</p>
  </div>
</div></div></section>

<!-- IMPORTANT NOTES -->
<section class="section section-alt"><div class="container">
<div class="notes-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(350px,1fr));gap:24px;margin-top:20px;">
  <div class="note-card reveal" style="background:#fff;border:1px solid #e8e8e8;border-radius:12px;padding:28px;">
    <h3 style="font-size:20px;color:#1a1a1a;margin-bottom:16px;">&#128670; Important Notes on Train & Flight Tickets</h3>
    <ul style="color:#666;line-height:1.8;padding-left:20px;">
      <li style="margin-bottom:8px;">Train and flight tickets are subject to the cancellation policies of China Railway and individual airlines.</li>
      <li style="margin-bottom:8px;">Train ticket cancellation fees are typically 5%-20% of the ticket price, deducted by China Railway directly.</li>
      <li style="margin-bottom:8px;">Flight cancellation fees vary by airline and fare class. Some discount fares may be non-refundable.</li>
      <li>We recommend purchasing comprehensive travel insurance that covers trip cancellation.</li>
    </ul>
  </div>
  <div class="note-card reveal" style="background:#fff;border:1px solid #e8e8e8;border-radius:12px;padding:28px;">
    <h3 style="font-size:20px;color:#1a1a1a;margin-bottom:16px;">&#128221; Amendment Policy</h3>
    <ul style="color:#666;line-height:1.8;padding-left:20px;">
      <li style="margin-bottom:8px;">Date changes and itinerary amendments are possible subject to availability.</li>
      <li style="margin-bottom:8px;">Minor amendments (hotel changes, activity swaps) are typically free of charge.</li>
      <li style="margin-bottom:8px;">Major amendments that affect pricing will be recalculated and any difference will be invoiced or refunded.</li>
      <li>All amendments must be confirmed in writing via email.</li>
    </ul>
  </div>
</div></div></section>

<!-- REFUND PROCESS -->
<section class="section"><div class="container"><div class="section-header reveal"><h2>Refund Process</h2><div class="divider"></div><p>Fast, transparent, and hassle-free refunds</p></div>
<div class="refund-steps" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px;margin-top:40px;">
  <div class="refund-step reveal" style="text-align:center;padding:28px 20px;background:#fff;border:1px solid #e8e8e8;border-radius:12px;">
    <div style="font-size:36px;margin-bottom:12px;">✉</div>
    <h3 style="font-size:17px;color:#1a1a1a;margin-bottom:8px;">1. Notify Us</h3>
    <p style="color:#666;">Send a cancellation request via email to booking@silkroadwondertours.com. Please include your booking reference number.</p>
  </div>
  <div class="refund-step reveal" style="text-align:center;padding:28px 20px;background:#fff;border:1px solid #e8e8e8;border-radius:12px;">
    <div style="font-size:36px;margin-bottom:12px;">&#9989;</div>
    <h3 style="font-size:17px;color:#1a1a1a;margin-bottom:8px;">2. Confirmation</h3>
    <p style="color:#666;">We'll confirm your cancellation within 24 hours and calculate the refund amount based on our policy.</p>
  </div>
  <div class="refund-step reveal" style="text-align:center;padding:28px 20px;background:#fff;border:1px solid #e8e8e8;border-radius:12px;">    <div style="font-size:36px;margin-bottom:12px;">&#128179;</div>
    <h3 style="font-size:17px;color:#1a1a1a;margin-bottom:8px;">3. Process Refund</h3>
    <p style="color:#666;">Refunds are processed within 7-14 business days to your original payment method.</p>
  </div>
  <div class="refund-step reveal" style="text-align:center;padding:28px 20px;background:#fff;border:1px solid #e8e8e8;border-radius:12px;">
    <div style="font-size:36px;margin-bottom:12px;">&#128176;</div>
    <h3 style="font-size:17px;color:#1a1a1a;margin-bottom:8px;">4. Receive Funds</h3>
    <p style="color:#666;">You'll receive the refund in your account. Time varies by payment method and bank processing.</p>
  </div>
</div></div></section>

<section class="cta-section"><div class="container"><div class="cta-grid">
  <div class="cta-text reveal"><h2>Ready to Start?</h2><p>Have questions about our cancellation policy? We're here to help.</p><a href="/contact.html" class="btn btn-gold">Contact Us Today</a></div>
</div></div></section>
<CtaSection />
</BaseLayout>