<section class="page-hero" style="background: url('/assets/images/hero-silkroad.jpg')">
  <div class="container"><h1>Beijing</h1><p>Discover 3,000 Years of Imperial History in China's Timeless Capital</p></div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://silkroadwondertours.com/" },
    { "@type": "ListItem", "position": 2, "name": "Destinations", "item": "https://silkroadwondertours.com/destinations.html" },
    { "@type": "ListItem", "position": 3, "name": "Beijing" }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Beijing Travel Guide — Discover 3,000 Years of Imperial History",
  "description": "Explore Beijing with Silk Road Wonders. Visit the Forbidden City, Great Wall, Temple of Heaven, Summer Palace, and traditional Hutongs. Expert-guided tours, best times to visit, and sample itineraries.",
  "url": "https://silkroadwondertours.com/destination/beijing.html",
  "touristType": ["Cultural Tourism", "Adventure Tourism", "Historical Tourism"],
  "provider": {
    "@type": "TravelAgency",
    "name": "Silk Road Wonder Tours",
    "url": "https://silkroadwondertours.com/",
    "image": "https://silkroadwondertours.com/assets/images/hero-silkroad.jpg"
  }
