  {name:"Xinjiang",url:"xinjiang-tours.html",img:"photo-1615554648482-72b47fe0d79d",keywords:"xinjiang uyghur kashgar urumqi kanas turpan"},
  {name:"Gansu",url:"gansu-tours.html",img:"photo-1600269452121-4f2416e55c28",keywords:"gansu lanzhou zhangye danxia jiayuguan dunhuang"},
  {name:"Tibet",url:"tibet-tours.html",img:"photo-1559829089-bc637e18ff53",keywords:"tibet lhasa everest kailash plateau buddhist"},
  {name:"Sichuan",url:"sichuan-tours.html",img:"photo-1509316785289-025f5b846b35",keywords:"sichuan chengdu panda jiuzhaigou emei mountain"},
  {name:"Yunnan",url:"yunnan-tours.html",img:"photo-1519681393784-d120267933ba",keywords:"yunnan kunming lijiang shangri-la dali tea horse"},
  {name:"Qinghai",url:"qinghai-tours.html",img:"photo-1517842645767-c639042777db",keywords:"qinghai qinghai lake xining amdo tibetan plateau"},
  {name:"Shanxi",url:"shanxi-tours.html",img:"photo-1558618665-3f1e54881834",keywords:"shanxi datong yungang grottoes pingyao ancient city"},
  {name:"Guangzhou",url:"destination/guangzhou.html",img:"photo-1548912233-f4d6741f447b",keywords:"guangzhou canton chen clan academy dim sum"}
], blog: [
  {name:"Gansu Intangible Heritage",url:"blog/gansu-heritage.html",keywords:"gansu heritage culture intangible unesco tradition"},
  {name:"China Diverse Destinations",url:"blog/china-diverse-destinations.html",keywords:"china diverse destinations travel guide variety"},
  {name:"Sven Hedin in Xinjiang",url:"blog/sven-hedin-xinjiang.html",keywords:"sven hedin xinjiang explorer history 130 years"},
  {name:"Gansu May Travel Guide",url:"blog/gansu-may-travel.html",keywords:"gansu may travel best season hexi corridor"},
  {name:"Silk Road Monthly Guide",url:"blog/silk-road-monthly-guide.html",keywords:"silk road monthly guide best time to visit season"},
  {name:"Silk Road Food Guide",url:"blog/silk-road-food-guide.html",keywords:"silk road food cuisine dishes must try lamb noodles"},
  {name:"Karakoram Highway",url:"blog/karakoram-highway.html",keywords:"karakoram highway highest paved road pakistan china"}
]};

function doSearch() {
  const q = document.getElementById('searchInput').value.trim().toLowerCase();
  if (!q) {
    document.getElementById('searchResults').style.display = 'none';
    document.getElementById('searchInfo').style.display = 'none';
    document.getElementById('noResults').style.display = 'none';
    document.getElementById('browseSection').style.display = '';
    return;
  }
  const terms = q.split(/\s+/);
  let tourResults = [], destResults = [], blogResults = [];
  searchData.tours.forEach(t => { if (terms.every(k => t.name.toLowerCase().includes(k) || t.keywords.includes(k))) tourResults.push(t); });
  searchData.destinations.forEach(d => { if (terms.every(k => d.name.toLowerCase().includes(k) || d.keywords.includes(k))) destResults.push(d); });
  searchData.blog.forEach(b => { if (terms.every(k => b.name.toLowerCase().includes(k) || b.keywords.includes(k))) blogResults.push(b); });
  const total = tourResults.length + destResults.length + blogResults.length;
  document.getElementById('searchInfo').style.display = '';
  document.getElementById('resultCount').textContent = total;
  document.getElementById('searchTerm').textContent = q;
  if (total === 0) {
    document.getElementById('searchResults').style.display = 'none';
    document.getElementById('noResults').style.display = '';
    document.getElementById('browseSection').style.display = '';
    document.getElementById('searchInput').style.borderColor = 'var(--clay)';
  } else {
    document.getElementById('searchInput').style.borderColor = '#4CAF50';
    document.getElementById('noResults').style.display = 'none';
    document.getElementById('searchResults').style.display = '';
    document.getElementById('browseSection').style.display = 'none';
    document.getElementById('resultTours').style.display = tourResults.length ? '' : 'none';
    document.getElementById('resultDests').style.display = destResults.length ? '' : 'none';
    document.getElementById('resultBlog').style.display = blogResults.length ? '' : 'none';
    document.getElementById('tourResults').innerHTML = tourResults.map(t => '<a href="'+t.url+'" class="tour-card" style="text-decoration:none;color:inherit;"><div class="tour-card-body"><h3>'+t.name+'</h3>'+(t.price?'<span style="color:var(--clay);font-weight:700;">From '+t.price+'</span>':'')+'</div></a>').join('');
    document.getElementById('destResults').innerHTML = destResults.map(function(d){ return '<a href="'+d.url+'" class="dest-card"><div class="img-placeholder" style="background-image:url(/assets/images/hero-mountains.jpg);background-size:cover;height:100px;"></div><span class="dest-name">'+d.name+'</span></a>'; }).join('');
    document.getElementById('blogResults').innerHTML = blogResults.map(b => '<a href="'+b.url+'" class="blog-card" style="text-decoration:none;color:inherit;"><div class="blog-card-body"><h3>'+b.name+'</h3></div></a>').join('');
  }
}

function quickSearch(term) {
  document.getElementById('searchInput').value = term;
  doSearch();
  document.getElementById('searchInput').focus();
}

document.getElementById('searchInput').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') { e.preventDefault(); doSearch(); }
});

// Handle ?q= from header search form
(function initSearchFromURL() {
  const params = new URLSearchParams(window.location.search);
  const q = params.get('q');
  if (q) {
    document.getElementById('searchInput').value = q;
    doSearch();
  }
})();

const tags = document.querySelectorAll('.search-tag');
tags.forEach(tag => {
  tag.addEventListener('mouseenter', function(){ this.style.background = 'var(--clay)'; this.style.color = '#fff'; });
  tag.addEventListener('mouseleave', function(){ this.style.background = 'var(--sand)'; this.style.color = 'var(--navy)'; });
});
</script>
<CtaSection />
</BaseLayout>