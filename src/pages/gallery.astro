---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/CtaSection.astro';
---
<BaseLayout title="Photo Gallery — Silk Road Wonders" description="Explore stunning photos from the Silk Road — Xinjiang, Gansu, Dunhuang, Kashgar, Central Asia. Breathtaking landscapes, ancient cities, and cultural moments." ogImage="/assets/images/hero-silkroad.jpg">
<section class="page-hero" style="background: url('/assets/images/xinjiang-landscape.jpg') center/cover;">
  <div class="container"><h1>Photo Gallery</h1><p>Journey through the Silk Road in pictures — landscapes, culture, and unforgettable moments</p></div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://silkroadwondertours.com/" },
    { "@type": "ListItem", "position": 2, "name": "Photo Gallery" }
  ]
}
</script>
<nav class="breadcrumb" aria-label="Breadcrumb"><div class="container"><a href="/">Home</a> <span class="sep">/</span> <span>Photo Gallery</span></div></nav>

<!-- FILTER -->
<section class="section" style="padding-bottom:0;"><div class="container">
<div class="gallery-filter">
  <button class="active" data-filter="all">All</button>
  <button data-filter="xinjiang">Xinjiang</button>
  <button data-filter="gansu">Gansu</button>
  <button data-filter="dunhuang">Dunhuang</button>
  <button data-filter="kashgar">Kashgar</button>
  <button data-filter="central-asia">Central Asia</button>
  <button data-filter="culture">Culture</button>
  <button data-filter="landscape">Landscapes</button>
</div></div></section>

<!-- GALLERY GRID -->
<section class="section"><div class="container">
<div class="gallery-grid">

<div class="gallery-item reveal" data-cat="xinjiang landscape">
  <img src="/assets/images/hero-silkroad.jpg" alt="Xinjiang grasslands" loading="lazy" width="1200" height="800">
  <div class="caption"><h2>Nalati Grasslands</h2><span>Xinjiang · Landscape</span></div>
</div>
<div class="gallery-item reveal" data-cat="dunhuang gansu landscape">
  <img src="/assets/images/hero-silkroad.jpg" alt="Dunhuang Crescent Lake" loading="lazy" width="1200" height="800">
  <div class="caption"><h2>Crescent Lake</h2><span>Dunhuang · Gansu</span></div>
</div>
<div class="gallery-item reveal" data-cat="kashgar xinjiang culture">
  <img src="/assets/images/hero-silkroad.jpg" alt="Kashgar Old City" loading="lazy" width="1200" height="800">
  <div class="caption"><h2>Kashgar Old City</h2><span>Xinjiang · Culture</span></div>
</div>
<div class="gallery-item reveal" data-cat="gansu landscape">
  <img src="/assets/images/xinjiang-landscape.jpg" alt="Zhangye Danxia" loading="lazy" width="1200" height="800">
  <div class="caption"><h2>Rainbow Mountains</h2><span>Zhangye · Gansu</span></div>
</div>
<div class="gallery-item reveal" data-cat="central-asia">
  <img src="/assets/images/hero-silkroad.jpg" alt="Samarkand Registan" loading="lazy" width="1200" height="800">
