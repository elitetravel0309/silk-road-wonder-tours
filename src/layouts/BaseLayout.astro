---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  twitterImage?: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description = 'Top China travel agency specializing in Silk Road tours across China and Central Asia since 2005.', ogImage, twitterImage, canonical, noindex = false } = Astro.props;

const siteUrl = 'https://silkroadwondertours.com';
const defaultOgImage = '/assets/images/og-default.jpg';

function absoluteUrl(path: string): string {
  if (!path) return siteUrl + defaultOgImage;
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  return siteUrl + (path.startsWith('/') ? path : '/' + path);
}

const ogImageUrl = absoluteUrl(ogImage || defaultOgImage);
const twitterImageUrl = absoluteUrl(twitterImage || ogImage || defaultOgImage);

// Current page path (must be defined before use below)
const pathname = Astro.url.pathname;

// Full page URL for og:url and canonical
const pageUrl = canonical || siteUrl + pathname;

// Determine if this is a blog article page
const isBlogPage = pathname.startsWith('/blog/') && pathname !== '/blog';
const ogType = isBlogPage ? 'article' : 'website';

// Blog publication dates for article meta tags
const blogDates: Record<string, string> = {
  'central-asia-travel-guide': '2026-05-31',
  'china-diverse-destinations': '2026-01-29',
  'china-train-travel-guide': '2026-05-31',
  'gansu-heritage': '2026-02-24',
  'gansu-may-travel': '2021-10-22',
  'karakoram-highway': '2026-05-31',
  'silk-road-food-guide': '2026-05-31',
  'silk-road-monthly-guide': '2026-05-31',
  'silk-road-packing-guide': '2026-05-31',
  'silk-road-tour-cost': '2026-08-29',
  'sven-hedin-xinjiang': '2026-05-31',
  'xinjiang-travel-guide': '2026-08-29',
};
const blogSlug = pathname.replace('/blog/', '').replace('/', '');
const articlePublishedTime = blogDates[blogSlug] || '2026-01-01';

// Auto-generate BreadcrumbList schema for tour detail pages
let breadcrumbSchema = '';
if (pathname.startsWith('/tour/')) {
  const pageTitle = title.replace(' | Silk Road Wonders', '');
  breadcrumbSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
      { "@type": "ListItem", "position": 2, "name": "Tours", "item": siteUrl + "/tours.html" },
      { "@type": "ListItem", "position": 3, "name": pageTitle }
    ]
  });
}

// Auto-generate Article schema for blog posts
let articleSchema = '';
if (pathname.startsWith('/blog/') && pathname !== '/blog') {
  const articleTitle = title.replace(' | Silk Road Wonders', '');
  const articleUrl = siteUrl + pathname;
  const articleImage = ogImageUrl;
  
  // Real publication dates mapped by blog slug
  const blogDates: Record<string, string> = {
    'central-asia-travel-guide': '2026-05-31',
    'china-diverse-destinations': '2026-01-29',
    'china-train-travel-guide': '2026-05-31',
    'gansu-heritage': '2026-02-24',
    'gansu-may-travel': '2021-10-22',
    'karakoram-highway': '2026-05-31',
    'silk-road-food-guide': '2026-05-31',
    'silk-road-monthly-guide': '2026-05-31',
    'silk-road-photography-tips': '2026-05-31',
    'sven-hedin-xinjiang': '2022-03-17'
  };
  
  const blogSlug = pathname.replace('/blog/', '').replace('.html', '').replace('/', '');
  const datePublished = blogDates[blogSlug] || '2026-01-01';
  const dateModified = '2026-08-28';
  
  articleSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": articleTitle,
    "description": description,
    "image": articleImage,
    "datePublished": datePublished,
    "dateModified": dateModified,
    "author": {
      "@type": "Organization",
      "name": "Silk Road Wonders",
      "url": siteUrl
    },
    "publisher": {
      "@type": "Organization",
      "name": "Silk Road Wonders",
      "logo": {
        "@type": "ImageObject",
        "url": siteUrl + "/assets/logo.png"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": articleUrl
    },
    "articleSection": "Travel Blog",
    "keywords": "Silk Road, China travel, Central Asia, Xinjiang, Tibet, Gansu, travel guide"
  });
}

// Organization schema (site-wide)
const organizationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": "Silk Road Wonders",
  "url": siteUrl,
  "logo": siteUrl + "/assets/logo.png",
  "image": siteUrl + "/assets/images/hero-silkroad.jpg",
  "description": "Top China travel agency specializing in Silk Road tours across China and Central Asia since 2005.",
  "foundingDate": "2005",
  "email": "booking@silkroadwondertours.com",
  "telephone": "+86-153-4444-4444",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Shanghai, China",
    "addressLocality": "Shanghai",
    "addressCountry": "CN"
  },
  "areaServed": ["China", "Central Asia", "Uzbekistan", "Kyrgyzstan", "Kazakhstan", "Tajikistan", "Turkmenistan"],
  "sameAs": [
    "https://www.facebook.com/silkroadwondertours",
    "https://www.instagram.com/silkroadwondertours",
    "https://www.youtube.com/@silkroadwondertours"
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "320"
  }
});
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="google-site-verification" content="djI7G9O9aSEJf4Cwi67r0oadfIODvf_1RerX1xH3LaQ" />
<title>{title} | Silk Road Wonders</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex, nofollow">}
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={ogType}>
<meta property="og:url" content={pageUrl}>
<meta property="og:image" content={ogImageUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="Silk Road Wonders">
<meta property="og:locale" content="en_US">
{isBlogPage && <meta property="article:published_time" content={articlePublishedTime}>}
{isBlogPage && <meta property="article:author" content="Silk Road Wonders">}
{isBlogPage && <meta property="article:section" content="Travel Blog">}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@silkroadtravel">
<meta name="twitter:creator" content="@silkroadtravel">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={twitterImageUrl}>
<link rel="canonical" href={pageUrl}>
<link rel="alternate" hreflang="en" href={canonical || Astro.url.href}>
<link rel="alternate" hreflang="x-default" href={canonical || Astro.url.href}>
<link rel="dns-prefetch" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Source+Sans+3:wght@300;400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Source+Sans+3:wght@300;400;500;600;700&display=swap"></noscript>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></noscript>
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#1B2A4A">
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-HGKX7GFMFY"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-HGKX7GFMFY');
</script>
<script type="application/ld+json" set:html={organizationSchema}></script>
{breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema}></script>}
{articleSchema && <script type="application/ld+json" set:html={articleSchema}></script>}
</head>
<body>
<a class="skip-to-content" href="#main-content">Skip to content</a>
<Header />
<main id="main-content" role="main">
<slot />
</main>
<Footer />
<MobileNav />
<script src="/js/main.js" defer></script>
</body>
</html>
